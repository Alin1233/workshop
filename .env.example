# Copier en .env pour surcharger les valeurs par défaut (aucun secret ici : voir scripts/init_secrets.py)
FRONT_BIND=0.0.0.0
FRONT_PORT=8080
JWT_TTL_SECONDS=900
ADMIN_EMAIL=admin@resilience.local
INTEGRITY_INTERVAL_SECONDS=15
LOG_LEVEL=INFO
# Ports de gestion (publiés sur 127.0.0.1) et sous-réseau dmz : décalés automatiquement dans les worktrees
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
GRAFANA_PORT=3000
# Dashboard de supervision (écran du Clip Chrono), admin / secrets/supervision_password ; VM : ssh -N -L 8091:127.0.0.1:8091 …
SUPERVISION_PORT=8091
DMZ_OCTET=250
# Assistant RAG (ops-assistant), interface sur MGMT_BIND (tunnel SSH vers la VM : ssh -N -L 8090:127.0.0.1:8090 …),
# identifiant admin / secrets/ops_assistant_password. Sur la VM, deploy.yml écrit lui-même COMPOSE_PROFILES et
# OLLAMA_BASE_URL selon pc_hote_ai_mode (ansible/group_vars/pc_hote.yml). Où joindre Ollama :
#   conteneur du profil ai http://ollama:11434 (défaut ; activer le profil ci-dessous, puis une fois :
#     docker compose exec ollama ollama pull llama3.2:3b && docker compose exec ollama ollama pull nomic-embed-text) ;
#   PC de délestage IA http://<ip>:11434 ; Ollama natif sous Docker Desktop (dev) http://host.docker.internal:11434
#   (sur la VM PC Hôte, le pare-feu nftables bloque l'accès d'un conteneur à un Ollama installé sur l'hôte)
# COMPOSE_PROFILES=ai
OLLAMA_BASE_URL=http://ollama:11434
OPS_ASSISTANT_PORT=8090
OPS_ASSISTANT_LLM_MODEL=llama3.2:3b
OPS_ASSISTANT_EMBED_MODEL=nomic-embed-text
# Threads CPU du LLM (0 = tous les cœurs) : 4 sur les 6 vCPU de la VM laisse du CPU à la stack pendant une réponse
OPS_ASSISTANT_LLM_NUM_THREAD=4
# Contexte des alertes actives, désactivé (vide) : Alertmanager exige le compte admin, qui permet de poser des silences,
# et l'assistant n'est que sur le réseau ai. À renseigner avec une API d'état en lecture seule (compatible
# /api/v2/alerts) joignable depuis ce réseau, quand elle existera.
OPS_ASSISTANT_ALERTMANAGER_URL=
# Pont de remédiation (restauration automatique de la base, EBIOS S5), monté en /bridge dans le moteur.
# Développement : ./.remediation-bridge, créé par `python3 scripts/remediation_bridge_dev.py init` AVANT
# `docker compose up` (sinon Docker le crée en root), puis `python3 scripts/remediation_bridge_dev.py run`.
# Sur la VM, deploy.yml écrit /var/lib/resilience-alpha/remediation-bridge (unités systemd resilience-remediation-bridge).
REMEDIATION_BRIDGE_DIR=./.remediation-bridge

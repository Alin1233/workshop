
# Remplace /etc/nginx/templates/includes/location_common.conf.template de l'image
# owasp/modsecurity-crs:4.25-nginx-alpine-lts, inclus au niveau server{} des deux serveurs (8080 et 8443).
# Les blocs jusqu'à « location = /50x.html » sont ceux de l'image, inchangés : à resynchroniser en cas de montée de version.

location /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "OK";
}

location /metrics/nginx {
    access_log off;
    allow ${METRICS_ALLOW_FROM};
    deny ${METRICS_DENY_FROM};
    proxy_store off;
    stub_status;
}

error_page 500 502 503 504  /50x.html;
location = /50x.html {
    root /usr/share/nginx/html;
}

# ── Resilience-Alpha : IP bloquées par le moteur de remédiation ($remediation_blocked, 00-remediation-blocklist.conf)
# Testé en phase « server rewrite », avant toute location et avant ModSecurity : la requête n'atteint ni le CRS ni le
# frontal. Le code 418 (jamais produit ailleurs) sert seulement à rejoindre la location nommée, inaccessible par URI :
# elle journalise le refus en JSON (event_type=waf_remediation_block) et répond 403.
error_page 418 = @remediation_blocked;
if ($remediation_blocked) {
    return 418;
}

location @remediation_blocked {
    modsecurity off;
    access_log /var/log/nginx/access.log remediation_block;
    default_type application/json;
    return 403 '{"detail":"blocked_by_remediation"}\n';
}
